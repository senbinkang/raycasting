{
  "name": "raycasting",
  "version": "1.0.0",
  "description": "一个纯 JavaScript 实现的 Wolfenstein 风格伪 3D 引擎，基于 DDA（Digital Differential Analysis）光线投射算法。",
  "main": "index.js",
  "directories": {
    "doc": "doc"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senbinkang/raycasting.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/senbinkang/raycasting/issues"
  },
  "homepage": "https://github.com/senbinkang/raycasting#readme",
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
